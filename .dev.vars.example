# Required RuneLite publisher secret.
# During Cloudflare deployment, paste one of the clan keys generated
# in your PixelB8 Clan Owner Office into the CLAN_FEED_KEY secret field.
CLAN_FEED_KEY=

# Required website viewer secret.
# Paste the Clan Feed Viewer Code generated in your PixelB8 Clan Owner Office
# into the CLAN_VIEWER_KEY secret field. Clanmates use this code for read-only access.
CLAN_VIEWER_KEY=

# Never put real secrets in this example file or commit a real .dev.vars file.
