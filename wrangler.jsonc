{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yourclanname-feed-cloudflare-setup",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",

  "secrets": {
    "required": [
      "CLAN_FEED_KEY"
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "CLAN_FEED_ROOM",
        "class_name": "ClanFeedRoom"
      }
    ]
  },

  "exports": {
    "ClanFeedRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
